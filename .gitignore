# No trailing slash: `node_modules/` matches DIRECTORIES ONLY, so a worktree
# that symlinks its node_modules at the shared checkout sees an unignored file
# and a broad `git add` commits a mode-120000 path. That merges as "untracked
# working tree files would be overwritten" in every checkout with a real
# directory there, and as a dangling symlink in a fresh clone.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# generated native folders
/ios
/android


# scratch cluster created by check:seeds-rls (removed on a clean run)
.seeds-rls-pgdata/

# scratch cluster created by check:share-visibility (removed on a clean run)
.share-visibility-pgdata/

# ephemeral agent scratch drafts — never part of the repo
.scratch/
