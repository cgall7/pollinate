# Copy to .env and fill in from Supabase dashboard → Settings → API.
# Project URL and anon/public key only — never put the service_role key in
# the app, it bypasses Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 'true' forces every cold launch to Onboarding and resets there on every
# foreground resume — set it locally to demo the app. Absent or any other
# value (including "false") is off. See App.js's DEMO_MODE derivation.
EXPO_PUBLIC_DEMO_MODE=

# One-tap "Continue as demo" login on the Onboarding landing screen — only
# renders when BOTH are set and DEMO_CONTENT is true (see demoMode.js). A
# real Supabase account's real credentials: never commit real values here or
# anywhere else in this repo, it's public. Ask in #b57ad406 for the current
# demo account if you need these.
EXPO_PUBLIC_DEMO_LOGIN_EMAIL=
EXPO_PUBLIC_DEMO_LOGIN_PASSWORD=
