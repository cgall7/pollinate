{
  "expo": {
    "name": "Pollinate",
    "slug": "pollinate",
    "scheme": "pollinate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "xyz.pollinateapp.ios",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:pollinateapp.xyz"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0C023"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-notifications"]
  }
}
